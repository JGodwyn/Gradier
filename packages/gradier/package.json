{
  "name": "gradier",
  "version": "0.1.0",
  "description": "Edit mesh gradients live on your site during development and save them straight to your codebase.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JGodwyn/Gradier.git",
    "directory": "packages/gradier"
  },
  "homepage": "https://github.com/JGodwyn/Gradier#readme",
  "bugs": "https://github.com/JGodwyn/Gradier/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gradier": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./overlay.js": "./dist/overlay.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "prepack": "npm run build && node -e \"require('fs').copyFileSync('../../README.md', 'README.md')\"",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "keywords": [
    "gradient",
    "mesh-gradient",
    "devtools",
    "vite-plugin",
    "design"
  ]
}
